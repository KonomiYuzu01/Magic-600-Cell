+def expected_steps(summary, library):
+    orbits = [(f'lattice/orbit-{o}', {'orbit': o, 'factor_first': first, 'factor_count': n})
+              for o, first, n in orbit_partition(summary) if n]
+    run = summary['runs'][0]
