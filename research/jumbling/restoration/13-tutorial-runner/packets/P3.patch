+class TimedResult(unittest.TextTestResult):
+    def startTest(self, test):
+        self.started = time.monotonic()
+        super().startTest(test)
+
+    def stopTest(self, test):
+        super().stopTest(test)
+        self.stream.writeln(f'  {test.id()}: {time.monotonic() - self.started:.3f}s')
+
