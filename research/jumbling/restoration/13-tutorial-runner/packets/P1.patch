+        with patch.dict(H.RULE_SCRIPTS, r22d75=script), patch.object(H, 'next_step', side_effect=checked):
+            runner.run()
+        self.assertEqual(runner.record['result'], 'error')
+        self.assertIn('word output digest mismatch', runner.record['error'])
