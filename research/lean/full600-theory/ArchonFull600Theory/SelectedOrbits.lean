import ArchonFull600Theory.InvariantBound

set_option linter.style.header false in
/-!
# Lemmas 9 to 11 on the retained model

Source: `research/Full_600cell_Puzzle_Theory.tex`, Lemma 9 (lines 1083 to 1132), Lemma 10
(lines 1134 to 1185) and Lemma 11 (lines 1187 to 1266), each stated under R and C.

Milestone 1 proved Lemmas 9 to 11 for an abstract legal group with nine disjoint invariant
orbits of the right sizes, nine pure-controller certificates, a 600-symbol solved colouring with
the right multiplicities, and (for Lemma 11) letters whose words realize every legal element.
Here these inputs are discharged on the retained model:

* the selected orbit `O_i` is the sticker set of the moving orbit `selectedOrbit i`; the nine are
  pairwise disjoint (`selectedOrbitStickers_disjoint`) and preserved by every legal element
  (`legal_mem_selectedOrbitStickers`), from R;
* their sizes `3600`, `2400` and `7200` come from the census through the orbit counts of R
  (`card_selectedOrbitStickers`, via `card_orbitStickers` and `selectedOrbitCensus`, N11), and
  each of their pieces carries exactly one sticker (`selected_single_sticker`);
* the certificates and the colouring multiplicities are the fields of C;
* the alphabet `{H_c, T_c, T_c⁻¹}` is indexed by an arbitrary enumeration `e : Fin 600 ≃ Cap`
  of the caps, and its words realize every legal element (`capWord_surjective`), because `G` is
  generated by the `H_c` and `T_c` and is finite, so `x⁻¹ = x ^ (ord x - 1)`.

The results: `HypothesisC.supportedAlternating` (Lemma 9: `A_3600 × A_2400 × A_7200^7` acting on
the nine selected orbits and fixing every other sticker), `HypothesisC.balancedColorBound`
(Lemma 10: `B ≤ |Ω|`, attained with every unselected sticker solved), and
`HypothesisC.wordDistanceBound` and `HypothesisC.totalVariationBound` (Lemma 11).
-/

namespace ArchonFull600Theory

open Equiv Finset

/-! ### Words in a chosen alphabet -/

section Words

variable {Slot : Type*} {legal : Subgroup (Perm Slot)}
  {Letter : Type*} (moves : Letter → legal)

theorem foldl_moves (w : List Letter) (g : legal) :
    w.foldl (fun g a => moves a * g) g = wordPermutation moves w * g := by
  induction w generalizing g with
  | nil => exact (one_mul g).symm
  | cons a w ih =>
    have h : wordPermutation moves (a :: w) = wordPermutation moves w * moves a := by
      change List.foldl (fun g a => moves a * g) (moves a * 1) w = _
      rw [ih, mul_one]
    change List.foldl (fun g a => moves a * g) (moves a * g) w = _
    rw [ih, h, mul_assoc]

/-- Words act chronologically: `u` first, then `v`. -/
theorem wordPermutation_append (u v : List Letter) :
    wordPermutation moves (u ++ v) = wordPermutation moves v * wordPermutation moves u := by
  rw [wordPermutation, List.foldl_append, foldl_moves moves v]
  rfl

theorem exists_word_pow (w : List Letter) (n : ℕ) :
    ∃ w' : List Letter, wordPermutation moves w' = wordPermutation moves w ^ n := by
  induction n with
  | zero => exact ⟨[], (pow_zero _).symm⟩
  | succ n ih =>
    obtain ⟨w', hw'⟩ := ih
    exact ⟨w ++ w', by rw [wordPermutation_append, hw', pow_succ]⟩

end Words

variable {Sticker Piece : Type*} [Fintype Sticker] [Fintype Piece] [DecidableEq Piece]

/-! ### The nine selected orbits under R -/

namespace HypothesisR

variable {M : RetainedModel Sticker Piece} (R : HypothesisR M)

/-- `|O_o| = k_o N_o` sticker slots. -/
theorem card_orbitStickers (o : Fin 35) :
    (R.orbitStickers o).card = (census o).stickersPerPiece * (census o).pieces := by
  rw [orbitStickers, card_eq_sum_card_fiberwise (f := M.piece)
    (t := univ.filter fun A => R.orbit A = some o)
    fun s hs => mem_filter.2 ⟨mem_univ _, (mem_filter.1 hs).2⟩]
  rw [sum_congr rfl (g := fun _ => (census o).stickersPerPiece) fun A hA => ?_, sum_const,
    smul_eq_mul, R.card_orbit, mul_comm]
  have hA' := (mem_filter.1 hA).2
  rw [filter_filter, ← R.card_stickers A o hA']
  congr 1
  exact filter_congr fun s _ => ⟨fun h => h.2, fun h => ⟨h ▸ hA', h⟩⟩

/-- **N11 on the model.** Each piece of a selected orbit carries exactly one sticker. -/
theorem selected_single_sticker (i : ↥selectedOrbitIds) (A : Piece)
    (hA : R.orbit A = some (selectedOrbit i)) : (univ.filter fun s => M.piece s = A).card = 1 := by
  rw [R.card_stickers A _ hA, (selectedOrbitCensus (selectedOrbit i) i.prop).1]

/-- **N11 on the model.** The selected orbits have `3600`, `2400` and `7200` sticker slots. -/
theorem card_selectedOrbitStickers (i : ↥selectedOrbitIds) :
    (R.orbitStickers (selectedOrbit i)).card =
      if i.val = 1 then 3600 else if i.val = 33 then 2400 else 7200 := by
  obtain ⟨h1, h2, -⟩ := selectedOrbitCensus (selectedOrbit i) i.prop
  rw [R.card_orbitStickers, h1, one_mul, h2]
  rfl

theorem selectedOrbitStickers_disjoint :
    Pairwise fun i j => Disjoint (R.orbitStickers (selectedOrbit i))
      (R.orbitStickers (selectedOrbit j)) := fun _ _ hij =>
  disjoint_filter.2 fun _ _ hi hj =>
    hij (selectedOrbit_injective (Option.some_injective _ (hi.symm.trans hj)))

theorem legal_mem_selectedOrbitStickers (i : ↥selectedOrbitIds) (g : M.legalGroup) (s : Sticker) :
    g.val s ∈ R.orbitStickers (selectedOrbit i) ↔ s ∈ R.orbitStickers (selectedOrbit i) := by
  simp only [orbitStickers, mem_filter, mem_univ, true_and, R.orbit_legal]

end HypothesisR

variable [DecidableEq Sticker]

/-! ### The cap alphabet -/

namespace RetainedModel

variable (M : RetainedModel Sticker Piece) (e : Fin 600 ≃ Cap)

/-- The letter `H_c` for the cap `c = e j`. -/
def capH (j : Fin 600) : M.legalGroup := ⟨M.H (e j), M.H_mem (e j)⟩

/-- The letter `T_c` for the cap `c = e j`. -/
def capT (j : Fin 600) : M.legalGroup := ⟨M.T (e j), M.T_mem (e j)⟩

omit [Fintype Sticker] [DecidableEq Sticker] [Fintype Piece] [DecidableEq Piece] in
/-- The unit-cost alphabet `{H_c, T_c, T_c⁻¹}` realizes every legal element. -/
theorem capWord_surjective [Finite Sticker] :
    Function.Surjective (wordPermutation (capLetterPermutation (M.capH e) (M.capT e))) := by
  rintro ⟨g, hg⟩
  have hg' : g ∈ Subgroup.closure (Set.range M.H ∪ Set.range M.T) := hg
  induction hg' using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with ⟨c, rfl⟩ | ⟨c, rfl⟩
    · refine ⟨[(e.symm c, 0)], Subtype.ext ?_⟩
      simp [wordPermutation, capLetterPermutation, capH]
    · refine ⟨[(e.symm c, 1)], Subtype.ext ?_⟩
      simp [wordPermutation, capLetterPermutation, capT]
  | one => exact ⟨[], rfl⟩
  | mul x y hx hy ihx ihy =>
    obtain ⟨u, hu⟩ := ihx hx
    obtain ⟨v, hv⟩ := ihy hy
    exact ⟨v ++ u, by rw [wordPermutation_append, hu, hv]; rfl⟩
  | inv x hx ihx =>
    obtain ⟨u, hu⟩ := ihx hx
    obtain ⟨w, hw⟩ := exists_word_pow (capLetterPermutation (M.capH e) (M.capT e)) u
      (orderOf (wordPermutation (capLetterPermutation (M.capH e) (M.capT e)) u) - 1)
    have hy : (⟨x, hx⟩ : M.legalGroup) ^ (orderOf (⟨x, hx⟩ : M.legalGroup) - 1) =
        (⟨x, hx⟩ : M.legalGroup)⁻¹ :=
      eq_inv_of_mul_eq_one_left (by
        rw [pow_sub_one_mul (orderOf_pos (⟨x, hx⟩ : M.legalGroup)).ne', pow_orderOf_eq_one])
    exact ⟨w, by rw [hw, hu, hy]; rfl⟩

end RetainedModel

/-! ### Lemmas 9 to 11 under R and C -/

namespace HypothesisC

variable {M : RetainedModel Sticker Piece} {R : HypothesisR M} {Color : Type*} [Fintype Color]
  [DecidableEq Color] {c₀ : Sticker → Color} (C : HypothesisC R c₀)
include C

/-- **Lemma 9.** Under R and C, `G` contains a subgroup acting as
`A_3600 × A_2400 × A_7200^7` on the nine selected single-sticker orbits (an injective
homomorphism from the product of their alternating groups, acting factorwise) and fixing every
other sticker. -/
theorem supportedAlternating :
    ∃ ρ : (∀ i, alternatingGroup ↥(R.orbitStickers (selectedOrbit i))) →* M.legalGroup,
      Function.Injective ρ ∧
      (∀ π i (s : R.orbitStickers (selectedOrbit i)), (ρ π).val s.val = ((π i).val s).val) ∧
      (∀ π, ((ρ π).val.support : Set Sticker) ⊆
        ⋃ i, (R.orbitStickers (selectedOrbit i) : Set Sticker)) :=
  supportedAlternatingActions M.legalGroup (fun i => R.orbitStickers (selectedOrbit i))
    R.selectedOrbitStickers_disjoint R.legal_mem_selectedOrbitStickers
    R.card_selectedOrbitStickers C.certificate

/-- **Lemma 10.** Under R and C, the reachable fixed-frame face-colour states number at least
`B = 3600!/(6!)^600 · 2400!/(4!)^600 · (7200!/(12!)^600)^7`, and `B` of them are attained by
legal elements fixing every sticker outside the nine selected orbits. -/
theorem balancedColorBound :
    balancedColorCount ≤ {x : Sticker → Color | ∃ g : M.legalGroup,
        (∀ s, (∀ i, s ∉ R.orbitStickers (selectedOrbit i)) → g.val s = s) ∧
          x = c₀ ∘ g.val.symm}.ncard ∧
      balancedColorCount ≤ (reachableColorings M.legalGroup c₀).ncard :=
  balancedColorLowerBound M.legalGroup (fun i => R.orbitStickers (selectedOrbit i))
    R.selectedOrbitStickers_disjoint R.legal_mem_selectedOrbitStickers
    R.card_selectedOrbitStickers C.certificate c₀ C.card_color C.copies

/-- **Lemma 11, the word ball.** Under R and C, for the alphabet `{H_c, T_c, T_c⁻¹ : c ∈ 𝒞}` of
`q = 1800` letters (in any enumeration of the caps), some reachable face-colour state has word
distance at least `46648` from solved. -/
theorem wordDistanceBound (e : Fin 600 ≃ Cap) :
    ∃ x : reachableColorings M.legalGroup c₀,
      46648 ≤ wordDistance M.legalGroup c₀ (capLetterPermutation (M.capH e) (M.capT e))
        (M.capWord_surjective e) x :=
  wordDistanceLowerBound M.legalGroup (fun i => R.orbitStickers (selectedOrbit i))
    R.selectedOrbitStickers_disjoint R.legal_mem_selectedOrbitStickers
    R.card_selectedOrbitStickers C.certificate c₀ C.card_color C.copies (M.capH e) (M.capT e)
    (M.capWord_surjective e)

/-- **Lemma 11, total variation.** Under R and C, a law supported on the states reached by
`1000`-letter words and the uniform law on `Ω` are at total-variation distance more than
`1 - 10^(-148595)`. -/
theorem totalVariationBound (e : Fin 600 ≃ Cap)
    (μ ν : Convexity.StdSimplex ℝ (reachableColorings M.legalGroup c₀))
    (hSupport : ∀ x ∈ μ.weights.support, ∃ w : List (Fin 600 × Fin 3),
      w.length = 1000 ∧
        wordColoring M.legalGroup c₀ (capLetterPermutation (M.capH e) (M.capT e)) w = x)
    (hUniform : ∀ x, ν.weights x = 1 / ((reachableColorings M.legalGroup c₀).ncard : ℝ)) :
    1 - ((10 ^ 148595 : ℕ) : ℝ)⁻¹ < totalVariation μ ν :=
  totalVariationLowerBound M.legalGroup (fun i => R.orbitStickers (selectedOrbit i))
    R.selectedOrbitStickers_disjoint R.legal_mem_selectedOrbitStickers
    R.card_selectedOrbitStickers C.certificate c₀ C.card_color C.copies (M.capH e) (M.capT e)
    (M.capWord_surjective e) μ ν hSupport hUniform

end HypothesisC

end ArchonFull600Theory
