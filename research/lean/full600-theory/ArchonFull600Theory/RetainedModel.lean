/-!
# The retained model, its hypotheses, and Lemma 6

Source: `research/Full_600cell_Puzzle_Theory.tex`, the retained-model definitions and hypotheses
(lines 736 to 882) and Lemma 6 (lines 883 to 949); handoff `research/ARCHON-HANDOFF-THEORY.md`,
section 4 (HR, HF, HC, HE) and section 6 (the hypotheses are inputs, not theorems).

`RetainedModel` holds the data: sticker slots `𝒮`, pieces `𝒫`, the sticker-to-piece map `ρ`, and
the chosen primitives `H_c`, `T_c` of each of the 600 caps. The legal group is
`G = ⟨H_c, T_c : c ∈ 𝒞⟩`. The hypotheses are separate structures, so that each lemma assumes
exactly the hypotheses the source names:

* `HypothesisR` (R): pieces are carried onto whole pieces; 600 one-sticker centres fixed by every
  legal move; 35 moving orbits with the census numbers `N_o`, `k_o` and ranks; the recorded
  addresses `(M(A), h)`; and the frame group `H_o ≤ S_{k_o}` of each orbit, isomorphic to the
  census type, containing every legal return map on a reference piece. The totals 177120 pieces
  and 259800 sticker slots are derived (`HypothesisR.card_piece`, `HypothesisR.card_sticker`).
* `HypothesisF` (F): each cap's tetrahedral rotation group, the even permutations of its four
  vertices, acts on the stickers, with `H_c` a half-turn and `T_c` a third-turn.
* `HypothesisC` (C): the nine pure-controller certificates and the solved colouring's
  multiplicities.
* `HypothesisE` (E): a faithful action of `K` on the same stickers that respects pieces, puts the
  centre slot of cap `c` at cap `k • c`, and conjugates the cap rotations of `c` into those of
  `k • c`.
* Hypothesis I is stated in `InvariantBound`, after the transported coordinates it refers to.

Lemma 6 here: `closure_primitives` (`H_c`, `T_c` generate the cap's `A₄` action, by the Klein
four-group argument checked over `A₄`), `HypothesisR.pieceAction` with `piece_legal` (`ρ` is
equivariant under every legal word), and `rank_multiplicity` (`r(A) = |M(A)| - 1`,
`k(A) = |Host(A)|`). Complete signatures identify the cut chambers (`completeSignature_eq_iff`
in `Chambers`), so distinct pieces have distinct signatures (`signature_injective`). With R's
`host_injective` (one patch per hosting facet, part of "no hidden identification"), `(M(A), h)`
addresses the sticker slots (`address_injective`).
-/

namespace ArchonFull600Theory

open Equiv Finset

theorem perm_apply_inv {α : Type*} (g : Perm α) (x : α) : g (g⁻¹ x) = x :=
  g.apply_symm_apply x

theorem perm_inv_apply {α : Type*} (g : Perm α) (x : α) : g⁻¹ (g x) = x :=
  g.symm_apply_apply x

/-! ### `A₄` is generated by a half-turn and a third-turn -/

section AlternatingFour

/-- **Lemma 6, the Klein four argument as a finite check.** For an even involution `h` and an
element `t` of order 3 of `S₄`, every even permutation is `t^a · (t^b h^e t^{-b})`: the conjugates
of `h` by the powers of `t` give the Klein four group, and its cosets by `t` give `A₄`. -/
theorem alternatingFour_words :
    ∀ p : Perm (Fin 4) × Perm (Fin 4), Perm.sign p.1 = 1 → p.1 * p.1 = 1 → p.1 ≠ 1 →
      p.2 * p.2 * p.2 = 1 → p.2 ≠ 1 →
      ∀ x : Perm (Fin 4), Perm.sign x = 1 →
        ∃ q : Fin 3 × Fin 3 × Fin 2,
          x = p.2 ^ (q.1 : ℕ) *
            (p.2 ^ (q.2.1 : ℕ) * p.1 ^ (q.2.2 : ℕ) * p.2 ^ (2 * (q.2.1 : ℕ))) := by
  decide +kernel

/-- A half-turn and a third-turn generate the rotation group `A₄` of a tetrahedron. -/
theorem closure_halfTurn_thirdTurn {α : Type*} [Fintype α] [DecidableEq α]
    (hα : Fintype.card α = 4) (h t : alternatingGroup α) (hh : orderOf h = 2)
    (ht : orderOf t = 3) : Subgroup.closure {h, t} = ⊤ := by
  let φ := Equiv.altCongrHom (Fintype.equivFinOfCardEq hα)
  have hh2 : (φ h).val * (φ h).val = 1 := by
    rw [← Subgroup.coe_mul, ← pow_two, ← map_pow, ← hh, pow_orderOf_eq_one, map_one]
    rfl
  have hh1 : (φ h).val ≠ 1 := by
    intro h1
    have : φ h = 1 := Subtype.ext h1
    rw [map_eq_one_iff φ φ.injective] at this
    rw [this, orderOf_one] at hh
    exact absurd hh (by norm_num)
  have ht3 : (φ t).val * (φ t).val * (φ t).val = 1 := by
    rw [← Subgroup.coe_mul, ← Subgroup.coe_mul, ← pow_three', ← map_pow, ← ht,
      pow_orderOf_eq_one, map_one]
    rfl
  have ht1 : (φ t).val ≠ 1 := by
    intro h1
    have : φ t = 1 := Subtype.ext h1
    rw [map_eq_one_iff φ φ.injective] at this
    rw [this, orderOf_one] at ht
    exact absurd ht (by norm_num)
  rw [eq_top_iff]
  intro x _
  obtain ⟨⟨a, b, e⟩, hx⟩ := alternatingFour_words ⟨(φ h).val, (φ t).val⟩
    (Equiv.Perm.mem_alternatingGroup.1 (φ h).prop) hh2 hh1 ht3 ht1 (φ x).val
    (Equiv.Perm.mem_alternatingGroup.1 (φ x).prop)
  have hword : x = t ^ (a : ℕ) * (t ^ (b : ℕ) * h ^ (e : ℕ) * t ^ (2 * (b : ℕ))) := by
    apply φ.injective
    apply Subtype.ext
    simp only [map_mul, map_pow, Subgroup.coe_mul, Subgroup.coe_pow]
    exact hx
  have hhm : h ∈ Subgroup.closure {h, t} := Subgroup.subset_closure (Set.mem_insert _ _)
  have htm : t ∈ Subgroup.closure {h, t} :=
    Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)
  rw [hword]
  exact Subgroup.mul_mem _ (Subgroup.pow_mem _ htm _) (Subgroup.mul_mem _
    (Subgroup.mul_mem _ (Subgroup.pow_mem _ htm _) (Subgroup.pow_mem _ hhm _))
    (Subgroup.pow_mem _ htm _))

end AlternatingFour

/-! ### The data -/

/-- **The retained model's data.** The sticker slots `𝒮` and pieces `𝒫` (as types), the
sticker-to-piece map `ρ = piece`, and the chosen primitives `H_c`, `T_c` of each cap as
permutations of all sticker slots. -/
structure RetainedModel (Sticker Piece : Type*) where
  piece : Sticker → Piece
  H : Cap → Perm Sticker
  T : Cap → Perm Sticker

namespace RetainedModel

variable {Sticker Piece : Type*} (M : RetainedModel Sticker Piece)

/-- **The legal group** `G = ⟨H_c, T_c : c ∈ 𝒞⟩ ≤ S_𝒮` (Lemma 7). Mathlib multiplies
permutations right to left: `h * g` is `g` followed by `h`. -/
def legalGroup : Subgroup (Perm Sticker) := Subgroup.closure (Set.range M.H ∪ Set.range M.T)

theorem H_mem (c : Cap) : M.H c ∈ M.legalGroup := Subgroup.subset_closure (Or.inl ⟨c, rfl⟩)

theorem T_mem (c : Cap) : M.T c ∈ M.legalGroup := Subgroup.subset_closure (Or.inr ⟨c, rfl⟩)

theorem legalGroup_le {S : Subgroup (Perm Sticker)} (hH : ∀ c, M.H c ∈ S)
    (hT : ∀ c, M.T c ∈ S) : M.legalGroup ≤ S := by
  rw [legalGroup, Subgroup.closure_le]
  rintro g (⟨c, rfl⟩ | ⟨c, rfl⟩)
  · exact hH c
  · exact hT c

/-- Sticker permutations that carry each whole piece onto a whole piece. -/
def pieceRespecting : Subgroup (Perm Sticker) where
  carrier := {g | ∀ s s', M.piece (g s) = M.piece (g s') ↔ M.piece s = M.piece s'}
  one_mem' := fun _ _ => Iff.rfl
  mul_mem' := by
    intro g h hg hh s s'
    change M.piece (g (h s)) = M.piece (g (h s')) ↔ M.piece s = M.piece s'
    rw [hg, hh]
  inv_mem' := by
    intro g hg s s'
    rw [← hg (g⁻¹ s) (g⁻¹ s'), perm_apply_inv, perm_apply_inv]

variable {M}

/-- The permutation of pieces induced by a piece-respecting permutation of stickers. -/
noncomputable def piecePerm (hρ : Function.Surjective M.piece) (g : M.pieceRespecting) :
    Perm Piece where
  toFun A := M.piece (g.val (Function.surjInv hρ A))
  invFun A := M.piece (g.val⁻¹ (Function.surjInv hρ A))
  left_inv A := by
    have hinv : g.val⁻¹ ∈ M.pieceRespecting := M.pieceRespecting.inv_mem g.prop
    have h := (hinv (Function.surjInv hρ (M.piece (g.val (Function.surjInv hρ A))))
      (g.val (Function.surjInv hρ A))).2 (Function.surjInv_eq hρ _)
    rw [perm_inv_apply] at h
    change M.piece (g.val⁻¹ (Function.surjInv hρ
      (M.piece (g.val (Function.surjInv hρ A))))) = A
    rw [h]
    exact Function.surjInv_eq hρ A
  right_inv A := by
    have h := (g.prop (Function.surjInv hρ (M.piece (g.val⁻¹ (Function.surjInv hρ A))))
      (g.val⁻¹ (Function.surjInv hρ A))).2 (Function.surjInv_eq hρ _)
    rw [perm_apply_inv] at h
    change M.piece (g.val (Function.surjInv hρ
      (M.piece (g.val⁻¹ (Function.surjInv hρ A))))) = A
    rw [h]
    exact Function.surjInv_eq hρ A

theorem piece_apply (hρ : Function.Surjective M.piece) (g : M.pieceRespecting) (s : Sticker) :
    M.piece (g.val s) = piecePerm hρ g (M.piece s) :=
  (g.prop s _).2 (Function.surjInv_eq hρ _).symm

/-- The induced permutations of pieces form a homomorphism. -/
noncomputable def pieceHom (hρ : Function.Surjective M.piece) :
    M.pieceRespecting →* Perm Piece where
  toFun := piecePerm hρ
  map_one' := Equiv.ext fun A => Function.surjInv_eq hρ A
  map_mul' g h := Equiv.ext fun A => by
    obtain ⟨s, rfl⟩ := hρ A
    rw [Perm.mul_apply, ← piece_apply, ← piece_apply, ← piece_apply]
    rfl

variable (M)

/-- Sticker permutations that keep every piece in its orbit class. -/
def orbitPreserving (orbit : Piece → Option (Fin 35)) : Subgroup (Perm Sticker) where
  carrier := {g | ∀ s, orbit (M.piece (g s)) = orbit (M.piece s)}
  one_mem' := fun _ => rfl
  mul_mem' := by
    intro g h hg hh s
    change orbit (M.piece (g (h s))) = orbit (M.piece s)
    rw [hg, hh]
  inv_mem' := by
    intro g hg s
    have h := hg (g⁻¹ s)
    rw [perm_apply_inv] at h
    exact h.symm

/-- Sticker permutations that fix every sticker of a piece in class `none` (a centre). -/
def centerFixing (orbit : Piece → Option (Fin 35)) : Subgroup (Perm Sticker) where
  carrier := {g | ∀ s, orbit (M.piece s) = none → g s = s}
  one_mem' := fun _ _ => rfl
  mul_mem' := by
    intro g h hg hh s hs
    change g (h s) = s
    rw [hh s hs, hg s hs]
  inv_mem' := by
    intro g hg s hs
    exact Perm.inv_eq_iff_eq.2 (hg s hs).symm

end RetainedModel

/-! ### The hypotheses -/

/-- The selected orbit `O_i` for `i ∈ {1, 4, 5, 7, 18, 19, 27, 31, 33}`. -/
def selectedOrbit (i : ↥selectedOrbitIds) : Fin 35 :=
  ⟨i.val, by
    have h := i.prop
    simp only [selectedOrbitIds, mem_insert, mem_singleton] at h
    omega⟩

theorem selectedOrbit_injective : Function.Injective selectedOrbit := fun _ _ h =>
  Subtype.ext (congrArg Fin.val h)

variable {Sticker Piece : Type*}

/-- **Hypothesis F: the full local cap action** (source lines 839 to 842). Each cap's tetrahedral
rotation group `A₄`, as the even permutations of the cap's four vertices, acts on the same sticker
slots; `H_c` is the action of an element of order 2 (a half-turn) and `T_c` of an element of
order 3 (a third-turn). -/
structure HypothesisF (M : RetainedModel Sticker Piece) where
  capAction : (c : Cap) → alternatingGroup ↥(c : Finset (Fin 120)) →* Perm Sticker
  halfTurn : (c : Cap) → alternatingGroup ↥(c : Finset (Fin 120))
  thirdTurn : (c : Cap) → alternatingGroup ↥(c : Finset (Fin 120))
  orderOf_halfTurn : ∀ c, orderOf (halfTurn c) = 2
  orderOf_thirdTurn : ∀ c, orderOf (thirdTurn c) = 3
  H_eq : ∀ c, M.H c = capAction c (halfTurn c)
  T_eq : ∀ c, M.T c = capAction c (thirdTurn c)

namespace HypothesisF

variable {M : RetainedModel Sticker Piece} (F : HypothesisF M)

/-- **Lemma 6, generation.** `H_c` and `T_c` generate the full `A₄` action at each cap. -/
theorem closure_primitives (c : Cap) :
    Subgroup.closure {M.H c, M.T c} = (F.capAction c).range := by
  rw [F.H_eq, F.T_eq, ← Set.image_pair, ← MonoidHom.map_closure,
    closure_halfTurn_thirdTurn (card_capVertices c) _ _ (F.orderOf_halfTurn c)
      (F.orderOf_thirdTurn c), ← MonoidHom.range_eq_map]

/-- Every cap rotation is a legal element. -/
theorem capAction_mem (c : Cap) (a : alternatingGroup ↥(c : Finset (Fin 120))) :
    F.capAction c a ∈ M.legalGroup := by
  have h : F.capAction c a ∈ Subgroup.closure {M.H c, M.T c} := by
    rw [F.closure_primitives]
    exact ⟨a, rfl⟩
  refine (Subgroup.closure_le _).2 ?_ h
  rintro g (rfl | rfl)
  · exact M.H_mem c
  · exact M.T_mem c

end HypothesisF

variable [Fintype Sticker] [Fintype Piece] [DecidableEq Piece]

/-- **Hypothesis R: the retained subdivision and legal action** (source lines 776 to 836).

* The legal primitives carry whole pieces onto whole pieces (`H_respects`, `T_respects`).
* Pieces of class `none` are the 600 centres: one sticker each, fixed by every primitive.
* Pieces of class `some o` form the moving orbit `O_o`: `N_o` pieces with `k_o` stickers each,
  kept in the class by the primitives and permuted transitively by the legal group.
* The model is the complete cut-chamber subdivision with no hidden identification: each piece
  is a cut chamber (`chamberPoint`, a point of its interior), distinct pieces are distinct
  chambers, and the hosting facet `h` of a sticker determines it within its piece. The census
  rank of `O_o` is `|M(A)| - 1` for the complete cap signature `M(A)` of the chamber.
* The frame group of `O_o` is a group `H_o` of permutations of the `k_o` stickers of a piece,
  isomorphic to the census type. In a reference ordering of the stickers of a reference piece,
  every legal element that maps that piece to itself acts by an element of `H_o` (the frame
  groups are taken after coherent transport, Lemma 7). -/
structure HypothesisR (M : RetainedModel Sticker Piece) where
  piece_surjective : Function.Surjective M.piece
  H_respects : ∀ c, M.H c ∈ M.pieceRespecting
  T_respects : ∀ c, M.T c ∈ M.pieceRespecting
  /-- The class of a piece: `none` for a centre, `some o` for the moving orbit `O_o`. -/
  orbit : Piece → Option (Fin 35)
  card_centers : (univ.filter fun A => orbit A = none).card = 600
  card_center_stickers : ∀ A, orbit A = none → (univ.filter fun s => M.piece s = A).card = 1
  H_fixes_centers : ∀ c s, orbit (M.piece s) = none → M.H c s = s
  T_fixes_centers : ∀ c s, orbit (M.piece s) = none → M.T c s = s
  card_orbit : ∀ o, (univ.filter fun A => orbit A = some o).card = (census o).pieces
  card_stickers : ∀ A o, orbit A = some o →
    (univ.filter fun s => M.piece s = A).card = (census o).stickersPerPiece
  H_orbit : ∀ c s, orbit (M.piece (M.H c s)) = orbit (M.piece s)
  T_orbit : ∀ c s, orbit (M.piece (M.T c s)) = orbit (M.piece s)
  /-- Each class `O_o` is one orbit of `G` on pieces (the reading of "moving orbit"). -/
  transitive : ∀ o A B, orbit A = some o → orbit B = some o →
    ∃ g ∈ M.legalGroup, ∀ s, M.piece s = A → M.piece (g s) = B
  /-- A point of the chamber interior of each piece. -/
  chamberPoint : Piece → ℍ
  chamberPoint_mem : ∀ A, chamberPoint A ∈ cutComplement
  /-- Distinct pieces are distinct cut chambers. -/
  chamber_injective : ∀ A B, chamberPoint B ∈ connectedComponentIn cutComplement (chamberPoint A) →
    A = B
  /-- The facet `h` hosting a sticker patch. -/
  host : Sticker → Cap
  host_injective : ∀ s s', M.piece s = M.piece s' → host s = host s' → s = s'
  rank_eq : ∀ A o, orbit A = some o →
    (completeSignature (chamberPoint A)).card = (census o).rank + 1
  /-- The frame group `H_o ≤ S_{k_o}`. -/
  frameGroup : (o : Fin 35) → Subgroup (Perm (Fin (census o).stickersPerPiece))
  frameGroup_equiv : ∀ o, Nonempty (frameGroup o ≃* (census o).frame.Carrier)
  refPiece : Fin 35 → Piece
  refPiece_orbit : ∀ o, orbit (refPiece o) = some o
  /-- The reference ordering of the stickers of the reference piece. -/
  refFrame : (o : Fin 35) → Fin (census o).stickersPerPiece → Sticker
  refFrame_piece : ∀ o f, M.piece (refFrame o f) = refPiece o
  refFrame_injective : ∀ o, Function.Injective (refFrame o)
  stabilizer_mem : ∀ o, ∀ g ∈ M.legalGroup, (∀ f, M.piece (g (refFrame o f)) = refPiece o) →
    ∃ a ∈ frameGroup o, ∀ f, g (refFrame o f) = refFrame o (a f)

namespace HypothesisR

variable {M : RetainedModel Sticker Piece} (R : HypothesisR M)

/-- The stickers of the moving orbit `O_o`. -/
def orbitStickers (o : Fin 35) : Finset Sticker := univ.filter fun s => R.orbit (M.piece s) = some o

end HypothesisR

/-- **Hypothesis C: the nine pure-controller certificates** (source lines 851 to 864). Each
selected orbit has a legal three-cycle fixing every other sticker, a legal relocation to buffers
`A_o, B_o` and an anchor `C_o`, and for every other position a legal setup fixing the buffers and
sending `C_o` to it (`PureControllerCertificate`, Milestone 1). The solved colouring `c₀` has 600
symbols, with six copies of each in `O01`, four in `O33` and twelve in each other selected
orbit. -/
structure HypothesisC [DecidableEq Sticker] {M : RetainedModel Sticker Piece} (R : HypothesisR M)
    {Color : Type*}
    [Fintype Color] [DecidableEq Color] (c₀ : Sticker → Color) where
  certificate : ∀ i : ↥selectedOrbitIds,
    PureControllerCertificate M.legalGroup (R.orbitStickers (selectedOrbit i) : Set Sticker)
  card_color : Fintype.card Color = 600
  copies : ∀ (i : ↥selectedOrbitIds) (color : Color),
    ((R.orbitStickers (selectedOrbit i)).filter fun s => c₀ s = color).card =
      if i.val = 1 then 6 else if i.val = 33 then 4 else 12

/-- **Hypothesis E: the equivariant geometric realization** (source lines 866 to 872). `K` acts
faithfully on the same labelled sticker slots as the legal moves and preserves the piece
grouping; the centre slot of cap `c` sits at its pole, so `k` sends it to the centre slot of
`k • c`; and, the subdivision being preserved, `k` conjugates the rotation `a` of cap `c` into
the rotation of cap `k • c` that permutes its vertices as `a` does through `k`. -/
structure HypothesisE {M : RetainedModel Sticker Piece} (R : HypothesisR M)
    (F : HypothesisF M) where
  geom : symmetryGroup →* Perm Sticker
  geom_injective : Function.Injective geom
  geom_respects : ∀ k, geom k ∈ M.pieceRespecting
  /-- The centre slot of each cap. -/
  center : Cap ≃ {s : Sticker // R.orbit (M.piece s) = none}
  geom_center : ∀ k c, geom k (center c).val = (center (k • c)).val
  geom_capAction : ∀ k c a, geom k * F.capAction c a * (geom k)⁻¹ =
    F.capAction (k • c) (Equiv.altCongrHom (capVertexEquiv k c) a)

/-! ### Lemma 6 -/

namespace HypothesisR

variable {M : RetainedModel Sticker Piece} (R : HypothesisR M)
include R

theorem legalGroup_le_pieceRespecting : M.legalGroup ≤ M.pieceRespecting :=
  M.legalGroup_le R.H_respects R.T_respects

theorem legalGroup_le_orbitPreserving : M.legalGroup ≤ M.orbitPreserving R.orbit :=
  M.legalGroup_le (fun c => R.H_orbit c) (fun c => R.T_orbit c)

theorem legalGroup_le_centerFixing : M.legalGroup ≤ M.centerFixing R.orbit :=
  M.legalGroup_le (fun c => R.H_fixes_centers c) (fun c => R.T_fixes_centers c)

/-- The action of the legal group on pieces. -/
noncomputable def pieceAction : M.legalGroup →* Perm Piece :=
  (RetainedModel.pieceHom R.piece_surjective).comp
    (Subgroup.inclusion R.legalGroup_le_pieceRespecting)

/-- **Lemma 6, equivariance.** `ρ(g(s)) = ḡ(ρ(s))` for every legal word `g`; `g ↦ ḡ` is a
homomorphism, so the equation is preserved under composition and inversion. -/
theorem piece_legal (g : M.legalGroup) (s : Sticker) :
    M.piece (g.val s) = R.pieceAction g (M.piece s) :=
  RetainedModel.piece_apply R.piece_surjective
    (Subgroup.inclusion R.legalGroup_le_pieceRespecting g) s

/-- Legal elements keep every piece in its moving orbit. -/
theorem orbit_legal (g : M.legalGroup) (s : Sticker) :
    R.orbit (M.piece (g.val s)) = R.orbit (M.piece s) :=
  R.legalGroup_le_orbitPreserving g.prop s

theorem orbit_pieceAction (g : M.legalGroup) (A : Piece) :
    R.orbit (R.pieceAction g A) = R.orbit A := by
  obtain ⟨s, rfl⟩ := R.piece_surjective A
  rw [← R.piece_legal, R.orbit_legal]

/-- Legal elements fix the centre stickers. -/
theorem fixes_center (g : M.legalGroup) (s : Sticker) (hs : R.orbit (M.piece s) = none) :
    g.val s = s :=
  R.legalGroup_le_centerFixing g.prop s hs

/-- The complete cap signature `M(A)` of a piece: the caps whose region contains its chamber. -/
noncomputable def signature (A : Piece) : Finset Cap := completeSignature (R.chamberPoint A)

/-- **Lemma 6, signature injectivity.** Complete signatures identify the cut chambers
(`completeSignature_eq_iff`) and distinct pieces are distinct chambers, so distinct pieces have
distinct complete signatures. -/
theorem signature_injective : Function.Injective R.signature := fun A B h =>
  R.chamber_injective A B
    ((completeSignature_eq_iff (R.chamberPoint_mem A) (R.chamberPoint_mem B)).1 h)

/-- The application rank `r(A) = |M(A)| - 1`. -/
noncomputable def applicationRank (A : Piece) : ℕ := (R.signature A).card - 1

/-- `Host(A)`: the facets hosting the sticker patches of `A`. -/
def hostSet (A : Piece) : Finset Cap := (univ.filter fun s => M.piece s = A).image R.host

/-- The sticker multiplicity `k(A) = |Host(A)|`. -/
def stickerMultiplicity (A : Piece) : ℕ := (R.hostSet A).card

/-- **Lemma 6, addresses.** `(M(A), h)` with `h ∈ Host(A)` addresses the sticker slots: the
signature determines the piece (`signature_injective`) and, by R's `host_injective`, the host
facet determines the sticker within its piece. -/
theorem address_injective : Function.Injective fun s => (R.signature (M.piece s), R.host s) := by
  intro s s' h
  simp only [Prod.mk.injEq] at h
  exact R.host_injective s s' (R.signature_injective h.1) h.2

/-- **Lemma 6, rank and multiplicity.** On the orbit `O_o`, `r(A)` is the census rank and
`k(A)` is both the census `k_o` and the number of stickers of `A`. -/
theorem rank_multiplicity (A : Piece) (o : Fin 35) (hA : R.orbit A = some o) :
    R.applicationRank A = (census o).rank ∧
      R.stickerMultiplicity A = (census o).stickersPerPiece ∧
      (univ.filter fun s => M.piece s = A).card = (census o).stickersPerPiece := by
  refine ⟨?_, ?_, R.card_stickers A o hA⟩
  · rw [applicationRank, signature, R.rank_eq A o hA, Nat.add_sub_cancel]
  · rw [stickerMultiplicity, hostSet, card_image_of_injOn, R.card_stickers A o hA]
    intro s hs s' hs' h
    rw [mem_coe, mem_filter] at hs hs'
    exact R.host_injective s s' (hs.2.trans hs'.2.symm) h

/-- **HR, the totals.** The census gives `600 + Σ N_o = 177120` pieces. -/
theorem card_piece : Fintype.card Piece = 177120 := by
  rw [← card_univ, card_eq_sum_card_fiberwise (f := R.orbit) (t := univ) (fun _ _ => mem_univ _),
    Fintype.sum_option, R.card_centers]
  simp only [R.card_orbit]
  exact censusSums.2.2

/-- **HR, the totals.** The census gives `600 + Σ k_o N_o = 259800` sticker slots. -/
theorem card_sticker : Fintype.card Sticker = 259800 := by
  have hfib (A : Piece) : (univ.filter fun s => M.piece s = A).card =
      (R.orbit A).elim 1 fun o => (census o).stickersPerPiece := by
    cases h : R.orbit A with
    | none => exact R.card_center_stickers A h
    | some o => exact R.card_stickers A o h
  have hnone : ∑ A ∈ univ.filter (fun A => R.orbit A = none),
      (R.orbit A).elim 1 (fun o => (census o).stickersPerPiece) = 600 := by
    rw [sum_congr rfl (g := fun _ => 1) fun A hA => by rw [(mem_filter.1 hA).2, Option.elim_none],
      sum_const, smul_eq_mul, mul_one, R.card_centers]
  have hsome (o : Fin 35) : ∑ A ∈ univ.filter (fun A => R.orbit A = some o),
      (R.orbit A).elim 1 (fun o => (census o).stickersPerPiece) =
        (census o).stickersPerPiece * (census o).pieces := by
    rw [sum_congr rfl (g := fun _ => (census o).stickersPerPiece) fun A hA => by
      rw [(mem_filter.1 hA).2, Option.elim_some], sum_const, smul_eq_mul, R.card_orbit, mul_comm]
  rw [← card_univ, card_eq_sum_card_fiberwise (f := M.piece) (t := univ) (fun _ _ => mem_univ _)]
  simp only [hfib]
  rw [← sum_fiberwise univ R.orbit, Fintype.sum_option, hnone]
  simp only [hsome]
  exact censusSums.2.1

end HypothesisR

end ArchonFull600Theory
