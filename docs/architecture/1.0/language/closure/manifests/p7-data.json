      "assumed": "No module-sharing option is selected; module payloads are outside this candidate.",
      "if_other": "Later packaging follows the selected sharing option, while source bytes, content dependencies and provenance remain preserved."
    },
    {
      "item": "LQ19",
      "assumed": "No gate ordering or implementation-start approval is assumed.",
      "if_other": "The owner may change charter order; the candidate still needs Astra ruling and subsequent owner sign-off."
