{
  "schema": 1,
  "description": "Allowlist for automatic development-time installation. Only entries with status 'verified' and installable true can be installed. Installing never runs from hooks or normal application startup.",
  "profiles": {
    "planning": "Now: notebooks, diagrams, documents, slides",
    "native-performance": "0.4.1 screening and optimization",
    "renderer-spike": "Stage 2.4 renderer experiments",
    "media": "Stages 5 and 7",
    "release": "Stage 8",
    "optional": "Install only when needed"
  },
  "owner_required": [
    "Visual Studio Build Tools",
    "Windows SDK",
    "Windows Performance Analyzer",
    "Windows Sandbox",
    "NVIDIA Nsight Graphics",
    "DaVinci Resolve",
    "Inno Setup"
  ],
  "tools": [
    {
      "id": "python",
      "purpose": "Runs project scripts and hooks",
      "profiles": [
        "planning"
      ],
      "method": "external",
      "status": "verified",
      "installable": false,
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "probe": [
        "{python}",
        "-c",
        "import platform,struct,sys;print(platform.python_implementation(),sys.version.split()[0],struct.calcsize('P')*8)"
      ],
      "expect": "CPython 3\\.(1[1-9]|[2-9]\\d)\\.\\d+ 64",
      "note": "64-bit CPython 3.11 or later, installed by the owner."
    },
    {
      "id": "git",
      "purpose": "Version control",
      "profiles": [
        "planning"
      ],
      "method": "external",
      "status": "verified",
      "installable": false,
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "probe": [
        "git",
        "--version"
      ],
      "note": "Git for Windows also provides the bash and curl that hooks and marimo-pair use."
    },
    {
      "id": "node",
      "purpose": "Runs npm-based tools",
      "profiles": [
        "planning"
      ],
      "method": "external",
      "status": "verified",
      "installable": false,
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "probe": [
        "node",
        "--version"
      ],
      "expect": "^v(2[2-9]|[3-9]\\d)\\.",
      "note": "Node.js 22 or later, installed by the owner (v24.21.0 recorded on the owner machine)."
    },
    {
      "id": "codex-cli",
      "purpose": "Codex reviewer through tools/agents/codex_review.py",
      "profiles": [
        "planning"
      ],
      "method": "external",
      "status": "verified",
      "installable": false,
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "probe": [
        "codex",
        "--version"
      ],
      "expect": "codex-cli 0\\.159\\.",
      "version": "0.159.0",
      "note": "Installed by the owner with `npm install -g @openai/codex@0.159.0`; login with `codex login`. Upgrades need owner approval because they can change model routing."
    },
    {
      "id": "uv",
      "purpose": "Installs pinned Python tools",
      "profiles": [
        "planning"
      ],
      "method": "pip-hashed",
      "status": "verified",
      "installable": true,
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "version": "0.12.20",
      "requirements": "tools/python/uv.txt",
      "probe": [
        "{python}",
        "-m",
        "uv",
        "--version"
      ],
      "expect": "uv 0\\.12\\.20",
      "license": "MIT OR Apache-2.0",
      "network_hosts": [
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "uninstall": "python -m pip uninstall uv"
    },
    {
      "id": "marimo",
      "purpose": "Reactive notebooks for evidence and data work",
      "profiles": [
        "planning"
      ],
      "method": "uv-venv-hashed",
      "status": "verified",
      "installable": true,
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "version": "0.25.0",
