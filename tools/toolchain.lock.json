        "uv"
      ],
      "venv": "tools/.venv/planning",
      "requirements": "tools/python/planning.txt",
      "probe": [
        "{venv}/marimo",
        "--version"
      ],
      "expect": "0\\.25\\.0",
      "license": "Apache-2.0",
      "network_hosts": [
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "uninstall": "delete tools/.venv/planning"
    },
    {
