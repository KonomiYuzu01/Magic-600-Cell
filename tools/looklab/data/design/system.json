  "roles": {
    "surface.window": {
      "group": "chrome",
      "meaning": "The window behind every panel."
    },
    "surface.panel": {
      "group": "chrome",
      "meaning": "A docked panel or bar."
    },
    "surface.control": {
      "group": "chrome",
      "meaning": "A control at rest."
    },
    "surface.raised": {
      "group": "chrome",
      "meaning": "A hovered control, a popup or a tooltip."
    },
    "surface.sunken": {
      "group": "chrome",
      "meaning": "A pressed control or an editable field."
    },
    "border.subtle": {
      "group": "chrome",
      "meaning": "The line between regions and around controls."
    },
    "border.strong": {
      "group": "chrome",
      "meaning": "The line around popups and the grabbers of scrollbars."
    },
    "text.primary": {
      "group": "chrome",
      "meaning": "Text and icons that are read."
    },
    "text.secondary": {
      "group": "chrome",
      "meaning": "Supporting text and idle icons."
    },
    "text.disabled": {
      "group": "chrome",
      "meaning": "Text of a control that cannot be used now."
    },
    "accent.base": {
      "group": "chrome",
      "meaning": "The one accent: the active choice, a filled slider, the text selection."
    },
    "accent.strong": {
      "group": "chrome",
      "meaning": "The accent as text or as a thin line on a surface."
    },
    "accent.text": {
      "group": "chrome",
      "meaning": "Text on the accent."
    },
    "focus.ring": {
      "group": "chrome",
      "meaning": "The keyboard focus indicator."
    },
    "grid.line": {
      "group": "chrome",
      "meaning": "Grid and guide lines; their strength follows the grid intensity knob."
    },
    "script.frame": {
      "group": "chrome",
      "meaning": "The frame around every area a script draws."
    },
    "state.committed": {
      "group": "state",
      "meaning": "The committed puzzle state.",
      "cue": "solid outline, no label"
    },
    "state.preview": {
      "group": "state",
      "meaning": "A pending preview that is not committed.",
      "cue": "dashed outline and the label \"preview\""
    },
    "state.pending": {
      "group": "state",
      "meaning": "A preview is waiting; shown on the main views.",
      "cue": "ring marker at the view corner"
    },
    "state.stale": {
      "group": "state",
      "meaning": "Applied, display stale: computed before the current state.",
      "cue": "hatched fill and the label \"stale\""
    },
    "state.invalid": {
      "group": "state",
      "meaning": "Impossible or refused.",
      "cue": "struck-through outline and the reason as text"
    },
    "state.selected": {
      "group": "state",
      "meaning": "The selection.",
      "cue": "corner brackets"
    },
    "state.protected": {
      "group": "state",
      "meaning": "A protected orbit or position.",
      "cue": "lock glyph"
    },
    "severity.error": {
      "group": "state",
      "meaning": "An error.",
      "cue": "octagon"
    },
    "severity.warning": {
      "group": "state",
      "meaning": "A warning.",
      "cue": "triangle"
    },
    "severity.info": {
      "group": "state",
      "meaning": "A note.",
      "cue": "circle"
    },
    "strip.destination": {
      "group": "encoding",
      "meaning": "Relationship strip: the destination.",
      "cue": "first place in the strip and a target glyph"
    },
    "strip.occupant": {
      "group": "encoding",
      "meaning": "Relationship strip: the current occupant.",
      "cue": "second place in the strip and a filled-cell glyph"
    },
    "strip.wanted": {
      "group": "encoding",
      "meaning": "Relationship strip: the wanted piece.",
      "cue": "third place in the strip and an outlined-cell glyph"
    },
    "strip.buffer": {
      "group": "encoding",
      "meaning": "Relationship strip: a buffer.",
      "cue": "fourth place in the strip and a bracket glyph"
    },
    "strip.frame": {
      "group": "encoding",
      "meaning": "Relationship strip: the frame.",
      "cue": "fifth place in the strip and an axes glyph"
    },
    "strip.residual": {
      "group": "encoding",
      "meaning": "Relationship strip: the residual.",
      "cue": "last place in the strip and a delta glyph"
    },
    "syntax.keyword": {
      "group": "syntax",
      "meaning": "A 600 Cell Script keyword."
    },
    "syntax.identifier": {
      "group": "syntax",
      "meaning": "A name."
    },
    "syntax.type": {
      "group": "syntax",
      "meaning": "A type name."
    },
    "syntax.number": {
      "group": "syntax",
      "meaning": "A number."
    },
    "syntax.string": {
      "group": "syntax",
      "meaning": "A string."
    },
    "syntax.operator": {
      "group": "syntax",
      "meaning": "An operator or a maths symbol."
    },
    "syntax.reference": {
      "group": "syntax",
      "meaning": "A typed reference to a cell, sticker, orbit or macro."
    },
    "syntax.comment": {
      "group": "syntax",
      "meaning": "A comment."
    }
  },
