    "script.frame": {
      "group": "chrome",
      "meaning": "The frame around every area a script draws."
    },
    "state.committed": {
      "group": "state",
      "meaning": "The committed puzzle state.",
      "cue": "solid outline, no label"
    },
    "state.preview": {
      "group": "state",
      "meaning": "A pending preview that is not committed.",
      "cue": "dashed outline and the label \"preview\""
