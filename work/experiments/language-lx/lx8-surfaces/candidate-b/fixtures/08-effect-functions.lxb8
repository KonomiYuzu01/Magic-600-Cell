edition: "lx8-0"
module protection_helpers requires [snapshot]

function delegated(snapshot: Snapshot<Full,Labels,Witnessed>, witness: Word<Full,Retained>) returns Verdict<Certificate<Full,Labels>> using [snapshot] charge [12, 0, 0, 0]:
    yield probe(snapshot, witness)

function probe(snapshot: Snapshot<Full,Labels,Witnessed>, witness: Word<Full,Retained>) returns Verdict<Certificate<Full,Labels>> using [snapshot] charge [12, 0, 0, 0]:
    yield check_word(snapshot, witness)
