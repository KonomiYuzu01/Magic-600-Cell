edition: "lx8-0"
module operation_records requires []

function describe_outcome(outcome: Outcome<Full>, error: TypedError<Full>, proposal: Proposal<Full>, preview: Preview<Full>, receipt: Receipt<Full>) returns Text using [] charge [12, 0, 0, 0]:
    yield outcome_text(outcome, error, proposal, preview)

function describe_controls(panel: Panel<Full,Labels>, control: Control<Full,Labels>, overlay: Overlay<Full,Labels>, instance: DisplayInstance<Full,Labels>, command: Command<Full>, binding: Binding<Full>, recording: Recording<Full>) returns Text using [] charge [12, 0, 0, 0]:
    yield interface_text(panel, control, overlay, instance, command, binding, recording)
