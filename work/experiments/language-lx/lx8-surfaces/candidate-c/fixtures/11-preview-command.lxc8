@edition("lx8-0");
@module(explicit_preview, [preview]);

cmd prepare(base: Revision<Full,Off>, witness: Word<Full,Retained>, provenance: Provenance) : Receipt<Full> ! [preview] @ [12, 0, 0, 0] with ("operation.preview", query, [operation], [prepare_preview]) =
    (base |> prepare_preview(witness, provenance));
