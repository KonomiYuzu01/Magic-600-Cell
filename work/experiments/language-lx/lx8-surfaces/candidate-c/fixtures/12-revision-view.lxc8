@edition("lx8-0");
@module(orbit_display, [snapshot, view]);

view orbit_view(snapshot: Snapshot<Full,Labels,Witnessed>, chart: Chart<Full,Labels,P53>, source: SourceMap) : View<Full,Labels> ! [snapshot, view] @ [12, 0, 0, 0] =
    bind scale <- ~53"0.5" in
    bind plan <- (snapshot |> make_plan(scale, chart, source)) in
    (plan |> publish());
