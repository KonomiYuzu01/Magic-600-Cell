@edition("lx8-0");
@module(orbit_identity, []);

fn describe(model: Model<Full>, cell: Cell<Full>, grip: Grip<Full>, cap: Cap<Full>, generator: Generator<Full>, menu_source: Menu<Jumble>, letter: MenuLetter<Jumble,MenuA>, piece: Piece<Full,Labels>, sticker: Sticker<Full,Labels>, slot: Slot<Full,Labels>, position: Position<Full,Labels>, pose: Pose<Jumble,Poses>, sticker_class: StickerClass<Jumble,Labels>, region_class: RegionClass<Jumble,Regions>, orbit: Orbit<Full,Labels>, level: Level<Labels>) : Text ! [] @ [12, 0, 0, 0] =
    (piece |> describe_identity(position));
