@edition("lx8-0");
@module(research_records, [budget]);

fn summarize(space: SearchSpace<Jumble,Poses>, record: SearchRecord<Jumble,Poses>, strategy: Strategy<Jumble,Poses>, rank: Rank<Jumble>, budget: Budget<Jumble,MenuLetters>, run: RunRecord<Jumble>, branch: Branch<Jumble>) : Text ! [budget] @ [12, 0, 0, 0] =
    (record |> research_note(budget));
