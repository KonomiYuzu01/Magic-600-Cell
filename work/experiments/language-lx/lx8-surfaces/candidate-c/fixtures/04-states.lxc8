@edition("lx8-0");
@module(state_difference, [snapshot]);

fn compare(before: Snapshot<Full,Labels,Witnessed>, after: DerivedState<Full,Labels,Witnessed>, jumble: Snapshot<Jumble,Poses,Witnessed>, derived: DerivedState<Jumble,Poses,Promised>) : Difference<Full,Labels> ! [snapshot] @ [12, 0, 0, 0] =
    (before |> difference(after));
