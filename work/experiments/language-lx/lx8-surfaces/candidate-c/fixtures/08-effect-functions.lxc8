@edition("lx8-0");
@module(protection_helpers, [snapshot]);

fn delegated(snapshot: Snapshot<Full,Labels,Witnessed>, witness: Word<Full,Retained>) : Verdict<Certificate<Full,Labels>> ! [snapshot] @ [12, 0, 0, 0] =
    (snapshot |> probe(witness));

fn probe(snapshot: Snapshot<Full,Labels,Witnessed>, witness: Word<Full,Retained>) : Verdict<Certificate<Full,Labels>> ! [snapshot] @ [12, 0, 0, 0] =
    (snapshot |> check_word(witness));
