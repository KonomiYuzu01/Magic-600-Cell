@edition("lx8-0");
@module(representation_inputs, []);

fn relations(graph: Graph<Full,Labels>, layout: Layout<Full,Labels>, projection: Projection<Jumble,Poses,Labels>, complex: CellComplex<Full,Labels,D2>, section: Section<Full,Labels>, atlas: Atlas<Full,Labels>, action: Action<Full,Labels>, embedding: Embedding<Full,Labels>, tree: Tree<Full,Labels>, states: StateGraph<Jumble,Poses>) : Relation<Full,Labels> ! [] @ [12, 0, 0, 0] =
    (graph |> representation(layout, projection, complex));
