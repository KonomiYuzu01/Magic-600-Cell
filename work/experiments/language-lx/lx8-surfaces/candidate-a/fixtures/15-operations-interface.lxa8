edition "lx8-0";
module operation_records requires [];

fn describe_outcome(outcome: Outcome<Full>, error: TypedError<Full>, proposal: Proposal<Full>, preview: Preview<Full>, receipt: Receipt<Full>) -> Text effects [] charge [12, 0, 0, 0] {
    return outcome_text(outcome, error, proposal, preview);
}

fn describe_controls(panel: Panel<Full,Labels>, control: Control<Full,Labels>, overlay: Overlay<Full,Labels>, instance: DisplayInstance<Full,Labels>, command: Command<Full>, binding: Binding<Full>, recording: Recording<Full>) -> Text effects [] charge [12, 0, 0, 0] {
    return interface_text(panel, control, overlay, instance, command, binding, recording);
}
