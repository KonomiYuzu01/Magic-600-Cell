edition "lx8-0";
module state_difference requires [snapshot];

fn compare(before: Snapshot<Full,Labels,Witnessed>, after: DerivedState<Full,Labels,Witnessed>, jumble: Snapshot<Jumble,Poses,Witnessed>, derived: DerivedState<Jumble,Poses,Promised>) -> Difference<Full,Labels> effects [snapshot] charge [12, 0, 0, 0] {
    return difference(before, after);
}
