edition "lx8-0";
module explicit_preview requires [preview];

command prepare(base: Revision<Full,Off>, witness: Word<Full,Retained>, provenance: Provenance) -> Receipt<Full> effects [preview] charge [12, 0, 0, 0] row "operation.preview" kind query contexts [operation] permits [prepare_preview] {
    return prepare_preview(base, witness, provenance);
}
