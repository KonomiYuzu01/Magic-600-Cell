    return claim_scope(claim, premise, domain, reachability);
}
view f0007_orbit_view(snapshot: Snapshot<Full,Labels,Witnessed>, chart: Chart<Full,Labels,P53>, source: SourceMap) -> View<Full,Labels> effects [snapshot, view] charge [12, 0, 0, 0] {
    let scale = ~53"0.5";
    let plan = make_plan(snapshot, scale, chart, source);
    return publish(plan);
}
fn f0008_length(witness: Word<Full,Retained>) -> Cost<Full,Generators> effects [] charge [12, 0, 0, 0] {
    return helpers_length(witness);
}
fn f0009_constants() -> Q5 effects [] charge [12, 0, 0, 0] {
    let large = ;
    let fraction = -6/8;
    let phi = q5(1/2, 1/2);
    let sum = exact_add(large, 7);
