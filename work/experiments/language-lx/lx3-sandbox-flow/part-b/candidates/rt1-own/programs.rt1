(rt1
  (input "caps" Targets)
  (input "target" Target)
  (input "word" Word)
  (input "words" Words)
  (run "r1"
    (kernel "n" Ints "counts")
    (calc "i" Int "argmax_first" (ref "n"))
    (calc "t" Target "index" (ref "caps") (ref "i"))
    (preview "receipt" Receipt (ref "word") (ref "t"))
  )
)
(rt1
  (input "caps" Targets)
  (input "target" Target)
  (input "word" Word)
  (input "words" Words)
  (run "r1"
    (kernel "n" Ints "counts")
    (calc "rank" Ints "rank_desc_indices" (ref "n"))
    (calc "i" Int "index" (ref "rank") (lit Int 0))
    (calc "t" Target "index" (ref "caps") (ref "i"))
    (preview "receipt" Receipt (ref "word") (ref "t"))
  )
)
(rt1
  (input "caps" Targets)
  (input "target" Target)
  (input "word" Word)
  (input "words" Words)
  (run "r1"
    (calc "scores" Ints "identity" (lit Ints []))
    (for "w" Word (ref "words")
      (kernel "s" Int "score" (ref "w"))
      (calc "scores" Ints "append" (ref "scores") (ref "s"))
    )
    (calc "i" Int "argmin_first" (ref "scores"))
    (calc "chosen" Word "index" (ref "words") (ref "i"))
    (calc "rebuilt" Word "concat" (lit Word []) (ref "chosen"))
    (preview "receipt" Receipt (ref "rebuilt") (ref "target"))
  )
)
(rt1
  (input "caps" Targets)
  (input "target" Target)
  (input "word" Word)
  (input "words" Words)
  (run "r1"
    (calc "scores" Ints "identity" (lit Ints []))
    (for "w" Word (ref "words")
      (kernel "s" Int "score" (ref "w"))
      (calc "scores" Ints "append" (ref "scores") (ref "s"))
    )
    (calc "i" Int "argmin_first" (ref "scores"))
    (calc "chosen" Word "index" (ref "words") (ref "i"))
    (workspace_put "selected_index" (ref "i"))
  )
  (run "r2"
    (workspace_get "i" Int "selected_index")
    (calc "rebuilt" Word "index" (ref "words") (ref "i"))
    (preview "receipt" Receipt (ref "rebuilt") (ref "target"))
  )
)
(rt1
  (input "target" Target)
  (input "word" Word)
  (run "r1"
    (kernel "nu" Ints "nu2")
    (calc "coeff" Ints "linear_solve_mod" (lit Matrix [[1,0],[0,1]]) (ref "nu") (lit Int 2))
    (calc "correction" Word "combine_corrections" (lit Words [["a"],["b"]]) (ref "coeff"))
    (preview "receipt" Receipt (ref "correction") (ref "target"))
  )
)
(rt1
  (input "target" Target)
  (input "word" Word)
  (run "r1"
    (kernel "nu" Ints "nu5")
    (calc "coeff" Ints "linear_solve_mod" (lit Matrix [[1,0],[0,1]]) (ref "nu") (lit Int 5))
    (calc "correction" Word "combine_corrections" (lit Words [["c"],["d"]]) (ref "coeff"))
    (preview "receipt" Receipt (ref "correction") (ref "target"))
  )
)
(rt1
  (input "caps" Targets)
  (input "target" Target)
  (input "word" Word)
  (input "words" Words)
  (run "r1"
    (kernel "n" Ints "counts")
    (calc "i" Int "argmax_first" (ref "n"))
    (calc "w" Word "index" (ref "words") (ref "i"))
    (workspace_put "saved" (ref "w"))
  )
  (run "r2"
    (workspace_get "w" Word "saved")
    (calc "renamed" Word "identity" (ref "w"))
    (workspace_put "renamed" (ref "renamed"))
    (preview "receipt" Receipt (ref "renamed") (ref "target"))
  )
)
(rt1
  (input "legacy" Word)
  (input "target" Target)
  (run "r1"
    (workspace_put "legacy" (ref "legacy"))
  )
  (run "r2"
    (workspace_get "w" Word "legacy")
    (preview "receipt" Receipt (ref "w") (ref "target"))
  )
)
(rt1
  (input "target" Target)
  (input "word" Word)
  (run "r1"
    (kernel "n" Ints "counts")
    (calc "n0" Int "index" (ref "n") (lit Int 0))
    (calc "test" Bool "gt" (ref "n0") (lit Int 0))
    (if (ref "test")
      (then
        (preview "receipt" Receipt (lit Word ["a"]) (ref "target"))
      )
      (else
        (preview "receipt" Receipt (lit Word ["b"]) (ref "target"))
      )
    )
  )
)
(rt1
  (input "target" Target)
  (input "word" Word)
  (run "r1"
    (kernel "bits" Ints "bits")
    (calc "b" Int "index" (ref "bits") (lit Int 1))
    (calc "test" Bool "eq" (ref "b") (lit Int 1))
    (if (ref "test")
      (then
        (calc "choice" Word "identity" (lit Word ["a"]))
      )
      (else
        (calc "choice" Word "identity" (lit Word ["b"]))
      )
    )
    (preview "receipt" Receipt (ref "choice") (ref "target"))
  )
)
(rt1
  (input "target" Target)
  (input "word" Word)
  (module "selector" (params) Word
    (kernel "n" Ints "nu2")
    (calc "v" Int "index" (ref "n") (lit Int 0))
    (calc "b" Bool "eq" (ref "v") (lit Int 1))
    (if (ref "b")
      (then
        (return (lit Word ["a"]))
      )
      (else
        (return (lit Word ["b"]))
      )
    )
  )
  (run "r1"
    (call "w" Word "selector")
    (preview "receipt" Receipt (ref "w") (ref "target"))
  )
)
(rt1
  (input "target" Target)
  (input "word" Word)
  (module "copy" (params ("x" Word)) Word
    (return (ref "x"))
  )
  (module "selector" (params) Word
    (kernel "n" Ints "nu2")
    (calc "v" Int "index" (ref "n") (lit Int 0))
    (calc "b" Bool "eq" (ref "v") (lit Int 1))
    (if (ref "b")
      (then
        (return (lit Word ["a"]))
      )
      (else
        (return (lit Word ["b"]))
      )
    )
  )
  (run "r1"
    (call "selected" Word "selector")
    (call "copied" Word "copy" (ref "selected"))
    (preview "receipt" Receipt (ref "copied") (ref "target"))
  )
)
