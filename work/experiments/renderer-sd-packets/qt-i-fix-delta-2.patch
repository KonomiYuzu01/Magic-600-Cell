+            client, peer = socket.socketpair()
+            received, connected, stop = bytearray(), [], threading.Event()
+
+            def serve():
+                with contextlib.suppress(OSError):
+                    while b"\r\n\r\n" not in received and not received.startswith(b"\x16"):
+                        chunk = peer.recv(4096)
