+class _DeadlineSocket:
+    """TLS socket mixin for archive downloads: every handshake, send and receive waits at most
+    SOCKET_TIMEOUT and never past the download deadline. A buffered read loops over many receives,
+    so a per-receive timeout alone would let a server that trickles bytes outlast the deadline."""
+
+    deadline: float
+
+    def _bound(self) -> None:
+        remaining = self.deadline - time.monotonic()
+        if remaining <= 0:
+            raise TimeoutError("download deadline exceeded")
+        self.settimeout(min(SOCKET_TIMEOUT, remaining))
+
+    def do_handshake(self, *args, **kwargs):
+        self._bound()
+        return super().do_handshake(*args, **kwargs)
+
+    def recv(self, *args, **kwargs):
+        self._bound()
+        return super().recv(*args, **kwargs)
+
+    def recv_into(self, *args, **kwargs):
+        self._bound()
+        return super().recv_into(*args, **kwargs)
+
+    def send(self, *args, **kwargs):
+        self._bound()
+        return super().send(*args, **kwargs)
+
+    def sendall(self, *args, **kwargs):
+        self._bound()
+        return super().sendall(*args, **kwargs)
+
