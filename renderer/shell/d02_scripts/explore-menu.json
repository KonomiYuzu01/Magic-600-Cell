{
  "format": "magic600-d02-script/1",
  "name": "explore-menu",
  "resolution": "1280x720",
  "note": "On the wj-ia-300 session fixture, open the Global context menu and close it with Escape. Explore pauses a commit. A state colour override marks both views; reset the colour and leave explore to clear the marks.",
  "steps": [
    { "wait_ms": 2500 },
    { "command": "menu.context.open", "argument": "global" },
    { "wait_ms": 600 },
    { "chord": "Escape" },
    { "command": "explore.set", "argument": "on" },
    { "wait_ms": 400 },
    { "command": "operation.preview.commit" },
    { "command": "token.override.set", "argument": "state.committed=0.6 0.15 30" },
    { "wait_ms": 600 },
    { "command": "token.override.reset", "argument": "state.committed=reset" },
    { "command": "explore.set", "argument": "off" },
    { "wait_ms": 6000 }
  ]
}
