# C9 U5: embeds the core's own HLSL (geometry.hlsl, draw.hlsl, stages.hlsl) in sa2_interop.dll, which composes it
# with a user stage's text at run time (src/stage_rules.cpp compose). Run as
#   cmake -D SHADERS=<renderer/core/shaders> -D OUTPUT=<header> -P embed.cmake
# The header holds each file's exact bytes and their count.
set(byte "0x[0-9a-f][0-9a-f],")
string(REPEAT "${byte}" 16 row)
set(text "#pragma once\n// Generated by renderer/core/embed.cmake; do not edit.\n#include <cstddef>\nnamespace sa2::stages::embedded {\n")
foreach(name geometry draw stages)
    file(READ "${SHADERS}/${name}.hlsl" hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR size "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(${row})" "\\1\n" bytes "${bytes}")
    string(APPEND text "inline constexpr unsigned char ${name}[] = {\n${bytes}0x00};\n")
    string(APPEND text "inline constexpr std::size_t ${name}_size = ${size};\n")
endforeach()
string(APPEND text "}\n")
file(WRITE "${OUTPUT}" "${text}")
