# ABI 7 (ADR-D02 B14): embeds the styled product pass's DXIL (styled_vs.dxil, styled_ps.dxil) in sa2_interop.dll, so
# that the build identity's eight shader files and the acceptance harness's copied set stay as they are; the DLL's
# digest covers the embedded bytes. Run as
#   cmake -D INPUT=<build directory> -D OUTPUT=<header> -P embed_dxil.cmake
# The header holds each blob's exact bytes and their count.
set(byte "0x[0-9a-f][0-9a-f],")
string(REPEAT "${byte}" 16 row)
set(text "#pragma once\n// Generated by renderer/core/embed_dxil.cmake; do not edit.\n#include <cstddef>\nnamespace sa2::styled {\n")
foreach(name styled_vs styled_ps)
    file(READ "${INPUT}/${name}.dxil" hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR size "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(${row})" "\\1\n" bytes "${bytes}")
    string(APPEND text "inline constexpr unsigned char ${name}[] = {\n${bytes}0x00};\n")
    string(APPEND text "inline constexpr std::size_t ${name}_size = ${size};\n")
endforeach()
string(APPEND text "}\n")
file(WRITE "${OUTPUT}" "${text}")
