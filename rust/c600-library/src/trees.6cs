}

fn tetrahedral_subgroups() -> List<List<Nat>> effects [] {
    return list<List<Nat>>(list<Nat>(0, 1, 14, 29, 30, 31, 32, 41, 42, 43, 44, 59), list<Nat>(2, 8, 11, 28, 29, 34, 36, 37, 39, 44, 45, 59), list<Nat>(3, 9, 10, 27, 30, 34, 35, 38, 39, 43, 46, 59), list<Nat>(4, 6, 13, 28, 31, 33, 35, 38, 40, 42, 45, 59), list<Nat>(5, 7, 12, 27, 32, 33, 36, 37, 40, 41, 46, 59));
}
