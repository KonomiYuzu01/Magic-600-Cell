edition "6cs-draft-1";
module recipes requires [];

export fn word_step(letters: Word) -> record { kind: Text, moves: Word, node: Nat, orbit: Nat, sign: Int } effects [] {
    return record { kind = "word", moves = letters, node = 0, orbit = 0, sign = 0 };
}

export fn star_step(orbit: Nat, node: Nat, sign: Int) -> record { kind: Text, moves: Word, node: Nat, orbit: Nat, sign: Int } effects [] {
    return record { kind = "star", moves = word[], node = node, orbit = orbit, sign = sign };
}

export fn star_word(setup: Word, relocation: Word, seed: Word) -> Word effects [] {
    return concat(concat(inverse(setup), inverse(relocation)), concat(seed, concat(relocation, setup)));
}

export fn frame_image(recipe: List<record { kind: Text, moves: Word, node: Nat, orbit: Nat, sign: Int }>, frame: List<Nat>) -> List<Nat> effects [snapshot] {
    let net = read_snapshot<record { destination: List<Nat>, source: List<Nat> }>("effect", recipe);
    return images(net.source, net.destination, frame);
}

export fn frame_maps(recipe: List<record { kind: Text, moves: Word, node: Nat, orbit: Nat, sign: Int }>, from: List<Nat>, to: List<Nat>) -> Bool effects [snapshot] {
    let net = read_snapshot<record { destination: List<Nat>, source: List<Nat> }>("effect", recipe);
    return exact_eq(images(net.source, net.destination, from), to);
}

export fn effect_report(recipe: List<record { kind: Text, moves: Word, node: Nat, orbit: Nat, sign: Int }>) -> record { destination: List<Nat>, expansion_sha256: Text, moved_pieces: Nat, moved_stickers: Nat, net_sha256: Text, primitive_count: Nat, source: List<Nat>, support: List<record { orbit: Int, pieces: Nat, stickers: Nat }> } effects [snapshot] {
    return read_snapshot<record { destination: List<Nat>, expansion_sha256: Text, moved_pieces: Nat, moved_stickers: Nat, net_sha256: Text, primitive_count: Nat, source: List<Nat>, support: List<record { orbit: Int, pieces: Nat, stickers: Nat }> }>("effect", recipe);
}

export fn orbit_report(recipe: List<record { kind: Text, moves: Word, node: Nat, orbit: Nat, sign: Int }>, orbits: List<Int>) -> record { moved_stickers: Nat, net_sha256: Text, others: List<record { orbit: Int, pieces: Nat, stickers: Nat }>, selected: List<record { orbit: Int, pieces: Nat, stickers: Nat }>, support: List<record { orbit: Int, pieces: Nat, stickers: Nat }> } effects [snapshot] {
    let net = read_snapshot<record { moved_stickers: Nat, net_sha256: Text, support: List<record { orbit: Int, pieces: Nat, stickers: Nat }> }>("effect", recipe);
    return record { moved_stickers = net.moved_stickers, net_sha256 = net.net_sha256, others = rows_in(net.support, orbits, false), selected = rows_in(net.support, orbits, true), support = net.support };
}

fn images(source: List<Nat>, destination: List<Nat>, frame: List<Nat>) -> List<Nat> effects [] {
    return repeat(length(frame), list<Nat>(), fn(done: List<Nat>) -> List<Nat> {
        return push(done, image(source, destination, index(frame, length(done))));
    });
}

fn image(source: List<Nat>, destination: List<Nat>, slot: Nat) -> Nat effects [] {
    let at = below(source, slot);
    return match exact_less(at, length(source)) {
        true => match exact_eq(index(source, at), slot) {
            true => index(destination, at);
            _ => slot;
        };
        _ => slot;
    };
}

fn below(source: List<Nat>, slot: Nat) -> Nat effects [] {
    let offsets = list<Nat>(131071, 65535, 32767, 16383, 8191, 4095, 2047, 1023, 511, 255, 127, 63, 31, 15, 7, 3, 1, 0);
    return repeat(length(offsets), record { count = 0, next = 0 }, fn(s: record { count: Nat, next: Nat }) -> record { count: Nat, next: Nat } {
        let at = exact_add(s.count, index(offsets, s.next));
        let count = match exact_less(at, length(source)) {
            true => match exact_less(index(source, at), slot) {
                true => exact_add(at, 1);
                _ => s.count;
            };
            _ => s.count;
        };
        return record { count = count, next = exact_add(s.next, 1) };
    }).count;
}

fn rows_in(rows: List<record { orbit: Int, pieces: Nat, stickers: Nat }>, orbits: List<Int>, wanted: Bool) -> List<record { orbit: Int, pieces: Nat, stickers: Nat }> effects [] {
    return repeat(length(rows), record { done = list<record { orbit: Int, pieces: Nat, stickers: Nat }>(), next = 0 }, fn(s: record { done: List<record { orbit: Int, pieces: Nat, stickers: Nat }>, next: Nat }) -> record { done: List<record { orbit: Int, pieces: Nat, stickers: Nat }>, next: Nat } {
        let row = index(rows, s.next);
        let done = match exact_eq(named(orbits, row.orbit), wanted) {
            true => push(s.done, row);
            _ => s.done;
        };
        return record { done = done, next = exact_add(s.next, 1) };
    }).done;
}

fn named(orbits: List<Int>, orbit: Int) -> Bool effects [] {
    return repeat(length(orbits), record { found = false, next = 0 }, fn(s: record { found: Bool, next: Nat }) -> record { found: Bool, next: Nat } {
        return record { found = or(s.found, exact_eq(index(orbits, s.next), orbit)), next = exact_add(s.next, 1) };
    }).found;
}
