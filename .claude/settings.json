{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/install_guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_gate.py"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python \"${CLAUDE_PROJECT_DIR}/tools/workbench/statusline.py\"",
    "refreshInterval": 30
  },
  "permissions": {
    "allow": [
      "Bash(python tools/toolchain/bootstrap.py check)",
      "Bash(python tools/toolchain/bootstrap.py check --profile:*)",
      "Bash(python tools/toolchain/bootstrap.py doctor)",
      "Bash(python tools/agents/codex_review.py --kind plan --packet:*)",
      "Bash(python tools/agents/codex_review.py --kind review --packet:*)",
      "Bash(python tools/skills/sync.py)",
      "Bash(python tools/skills/sync.py --check)",
      "Bash(python tools/wiki/lint.py:*)",
      "Bash(python3 tools/skills/sync.py --check)",
      "Bash(python3 tools/wiki/lint.py)",
      "mcp__github__pull_request_read"
    ],
    "ask": [
      "Bash(python tools/toolchain/bootstrap.py install:*)",
      "Bash(python tools/toolchain/bootstrap.py install-skill:*)",
      "Bash(python tools/toolchain/bootstrap.py pin:*)",
      "Bash(python tools/skills/sync.py --update-lock)"
    ],
    "deny": [
      "Bash(python tools/toolchain/bootstrap.py approve)",
      "Bash(python tools/toolchain/bootstrap.py approve:*)",
      "Edit(./work/loop-memory/approvals/**)",
      "Write(./work/loop-memory/approvals/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
