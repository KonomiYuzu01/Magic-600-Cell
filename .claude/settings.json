{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/install_guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_gate.py"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import os,runpy,sys;p=sys.argv[1];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_event.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python \"${CLAUDE_PROJECT_DIR}/tools/workbench/statusline.py\"",
    "refreshInterval": 30
  },
  "permissions": {
    "allow": [
      "Bash(python tools/toolchain/bootstrap.py check)",
      "Bash(python tools/toolchain/bootstrap.py check --profile:*)",
      "Bash(python tools/toolchain/bootstrap.py doctor)",
      "Bash(python tools/agents/codex_review.py --kind plan --packet:*)",
      "Bash(python tools/agents/codex_review.py --kind review --packet:*)",
      "Bash(python tools/skills/sync.py)",
      "Bash(python tools/skills/sync.py --check)",
      "Bash(python tools/wiki/lint.py:*)",
      "Bash(python3 tools/skills/sync.py --check)",
      "Bash(python3 tools/wiki/lint.py)",
      "mcp__github__pull_request_read",
      "Bash(python tools/workbench/progress.py:*)",
      "Bash(python tools/workbench/brief.py:*)",
      "Bash(python tools/workbench/ask.py:*)",
      "Bash(python tests/test_agent_rules_sync.py)",
      "Bash(python tests/test_b412_fixture.py)",
      "Bash(python tests/test_b412_summary.py)",
      "Bash(python tests/test_bootstrap.py)",
      "Bash(python tests/test_browser_ui.py)",
      "Bash(python tests/test_build_identity.py)",
      "Bash(python tests/test_cell_views.py)",
      "Bash(python tests/test_checkout_bytes.py)",
      "Bash(python tests/test_codex_implement.py)",
      "Bash(python tests/test_codex_review.py)",
      "Bash(python tests/test_color_inspection.py)",
      "Bash(python tests/test_continuity_04.py)",
      "Bash(python tests/test_core.py)",
      "Bash(python tests/test_crash.py)",
      "Bash(python tests/test_debug_cleanup.py)",
      "Bash(python tests/test_engine_lifecycle.py)",
      "Bash(python tests/test_experiment_send_outcome.py)",
      "Bash(python tests/test_fixture_respects_locks.py)",
      "Bash(python tests/test_forecast_guard.py)",
      "Bash(python tests/test_frame_preferences.py)",
      "Bash(python tests/test_full_reference_replay.py)",
      "Bash(python tests/test_http_boundary.py)",
      "Bash(python tests/test_inspection_focus.py)",
      "Bash(python tests/test_log_budget.py)",
      "Bash(python tests/test_log_workflow.py)",
      "Bash(python tests/test_mpult_log.py)",
      "Bash(python tests/test_native_auxiliary_controls.py)",
      "Bash(python tests/test_native_bridge.py)",
      "Bash(python tests/test_native_launch_reuse.py)",
      "Bash(python tests/test_native_reply_after_commit.py)",
      "Bash(python tests/test_native_selection_http.py)",
      "Bash(python tests/test_native_snapshot.py)",
      "Bash(python tests/test_native_snapshot_cache.py)",
      "Bash(python tests/test_native_startup_contract.py)",
      "Bash(python tests/test_orbit_switch_atomic.py)",
      "Bash(python tests/test_packaged_engine_command.py)",
      "Bash(python tests/test_piece_filters.py)",
      "Bash(python tests/test_portable_package.py)",
      "Bash(python tests/test_print_identity.py)",
      "Bash(python tests/test_recovery_camera.py)",
      "Bash(python tests/test_reference_maps.py)",
      "Bash(python tests/test_renderer_gate.py)",
      "Bash(python tests/test_scramble.py)",
      "Bash(python tests/test_stop_gate.py)",
      "Bash(python tests/test_turn_probe.py)",
      "Bash(python tests/test_v02.py)",
      "Bash(python tests/test_wiki_lint.py)",
      "Bash(python tests/test_workbench.py)",
      "Bash(python tests/test_workbench_cli.py)",
      "Bash(python tests/test_workbench_home.py)",
      "Bash(python tests/test_workbench_runs.py)",
      "Bash(python tests/test_workbench_ui.py)",
      "Bash(python tests/test_workbench_watch.py)",
      "Bash(python tests/test_workflow_windows.py)"
    ],
    "ask": [
      "Bash(python tools/toolchain/bootstrap.py install:*)",
      "Bash(python tools/toolchain/bootstrap.py install-skill:*)",
      "Bash(python tools/toolchain/bootstrap.py pin:*)",
      "Bash(python tools/skills/sync.py --update-lock)"
    ],
    "deny": [
      "Bash(python tools/toolchain/bootstrap.py approve)",
      "Bash(python tools/toolchain/bootstrap.py approve:*)",
      "Edit(./work/loop-memory/approvals/**)",
      "Write(./work/loop-memory/approvals/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
