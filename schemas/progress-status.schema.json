{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public progress state",
  "description": "docs/progress/status.json: sanitized public progress of 0.4.1 (steps 1 to 7) and stage 2 (2.0 to 2.5), read by the development workbench and the Claude Code status line. Acceptance text only where a repository document records it, with that document as its source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated", "current", "paid_api_ceiling_usd", "steps"],
  "properties": {
    "schema": {"type": "integer", "enum": [1]},
    "updated": {"type": "string"},
    "current": {"type": "string"},
    "paid_api_ceiling_usd": {"type": "integer", "enum": [100, 150, 300]},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "track", "title", "status", "acceptance", "acceptance_source", "blocker"],
        "properties": {
          "id": {"type": "string"},
          "track": {"type": "string", "enum": ["0.4.1", "stage-2"]},
          "title": {"type": "string"},
          "status": {"type": "string", "enum": ["not_started", "in_progress", "blocked", "done"]},
          "acceptance": {"type": ["string", "null"]},
          "acceptance_source": {"type": ["string", "null"]},
          "blocker": {"type": ["string", "null"]}
        }
      }
    }
  }
}
