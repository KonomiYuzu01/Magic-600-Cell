{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private model-call ledger entry",
  "description": "One line per model call in work/loop-memory/ledgers/*.jsonl, written by the calling wrapper. Never published.",
  "type": "object",
  "additionalProperties": true,
  "required": ["call_id", "time", "agent", "kind", "channel", "requested", "resolved", "packet_sha256", "source_identity", "outcome", "cost"],
  "properties": {
    "call_id": {"type": "string"},
    "time": {"type": "string"},
    "agent": {"type": "string", "enum": ["codex", "claude", "fable", "api-team"]},
    "kind": {"type": "string"},
    "channel": {"type": "string", "enum": ["subscription", "paid-api"]},
    "gate": {"type": ["string", "null"]},
    "requested": {
      "type": "object",
      "required": ["model", "effort", "speed"],
      "properties": {"model": {"type": "string"}, "effort": {"type": "string"}, "speed": {"type": "string"}}
    },
    "resolved": {
      "type": "object",
      "required": ["model", "effort", "sandbox"],
      "properties": {"model": {"type": ["string", "null"]}, "effort": {"type": ["string", "null"]}, "sandbox": {"type": ["string", "null"]}}
    },
    "packet_sha256": {"type": "string"},
    "source_identity": {"type": ["string", "null"]},
    "outcome": {"type": "string", "enum": ["pass", "findings", "inconclusive", "invalid", "timeout", "error"]},
    "cost": {
      "type": "object",
      "required": ["status", "usd"],
      "properties": {
        "status": {"type": "string", "enum": ["subscription", "reserved", "estimated", "billed", "unknown"]},
        "usd": {"type": ["number", "null"]}
      }
    }
  }
}
